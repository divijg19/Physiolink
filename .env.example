# Copy to .env and fill in. .env is gitignored; never commit it.
#
# Every variable below is read by backend/internal/config. Values shown are the
# insecure defaults the code falls back to when a variable is unset - set them
# explicitly rather than relying on those defaults.

# Address the API listens on.
BIND_ADDR=:8080

# Postgres connection string. Must match POSTGRES_DB/PORT below.
# The compose stack publishes Postgres on 127.0.0.1:5433.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/physiolink?sslmode=disable

# Signs and verifies session JWTs. MUST be set and MUST be unique per
# environment: anyone holding this value can mint a token for any user id and
# role. Use 32+ random bytes, e.g. `openssl rand -base64 32`.
# Leaving it unset makes every token signed with the literal string "changeme".
JWT_SECRET=

# Read by config but currently unused by the backend (no Redis client exists).
# Kept here so the value is documented rather than discovered in a shell.
REDIS_URL=redis://localhost:6379

# "development" or "production". Read by config but not yet branched on.
APP_ENV=development

# Credentials for the compose stack. Only change these together with
# DATABASE_URL above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=physiolink
